---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Container from '../../../components/ui/Container.astro';
import Breadcrumbs from '../../../components/ui/Breadcrumbs.astro';
import ContactCTA from '../../../components/sections/ContactCTA.astro';
import { CalendarDays, ArrowRight } from 'lucide-react';
import { business } from '../../../data/business';
import { buildBreadcrumbSchema } from '../../../lib/schema';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { id: post.id },
    props: { post, allPosts: posts }
  }));
}

const { post, allPosts } = Astro.props;
const { Content } = await render(post);

const related = allPosts
  .filter((p) => p.id !== post.id && p.data.category === post.data.category)
  .slice(0, 3);

const breadcrumbSchema = buildBreadcrumbSchema([
  { name: 'Home', path: '/' },
  { name: 'Blog', path: '/blog/' },
  { name: post.data.title, path: `/blog/${post.id}/` }
]);

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.publishDate.toISOString(),
  author: { '@type': 'Person', name: post.data.author },
  publisher: { '@type': 'Organization', name: business.name },
  mainEntityOfPage: `${business.url}/blog/${post.id}/`
};

function formatDate(d: Date) {
  return d.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });
}
---

<BaseLayout
  title={`${post.data.title} | ${business.name} Blog`}
  description={post.data.description}
  schema={[breadcrumbSchema, articleSchema]}
>
  <section class="bg-white py-16 sm:py-20">
    <Container class="mx-auto max-w-3xl">
      <Breadcrumbs
        crumbs={[{ label: 'Home', href: '/' }, { label: 'Blog', href: '/blog/' }, { label: post.data.category }]}
      />

      <p class="font-display mt-6 text-xs font-bold tracking-wider text-orange-600 uppercase">{post.data.category}</p>
      <h1 class="font-display text-ink-900 mt-2 text-3xl leading-[1.1] font-extrabold text-balance sm:text-4xl">
        {post.data.title}
      </h1>
      <div class="text-ink-500 mt-4 flex items-center gap-4 text-sm">
        <span class="flex items-center gap-1.5">
          <CalendarDays className="size-4" aria-hidden="true" />
          {formatDate(post.data.publishDate)}
        </span>
        <span>Written by {post.data.author}</span>
      </div>

      <div class="prose-blog text-ink-700 mt-10 max-w-none">
        <Content />
      </div>
    </Container>
  </section>

  {
    related.length > 0 && (
      <section class="border-ink-100 border-t bg-mist-100 py-16 sm:py-20">
        <Container class="mx-auto max-w-3xl">
          <h2 class="font-display text-ink-900 text-xl font-bold">More on {post.data.category}</h2>
          <div class="mt-6 grid gap-4 sm:grid-cols-3">
            {related.map((p) => (
              <a href={`/blog/${p.id}/`} class="card-elevated group p-5">
                <h3 class="font-display text-ink-900 text-sm font-bold group-hover:text-orange-600">{p.data.title}</h3>
                <span class="mt-3 flex items-center gap-1 text-xs font-semibold text-orange-600">
                  Read <ArrowRight className="size-3.5" aria-hidden="true" />
                </span>
              </a>
            ))}
          </div>
        </Container>
      </section>
    )
  }

  <ContactCTA />
</BaseLayout>
