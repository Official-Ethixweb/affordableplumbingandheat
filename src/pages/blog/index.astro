---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/sections/PageHero.astro';
import ContactCTA from '../../components/sections/ContactCTA.astro';
import Container from '../../components/ui/Container.astro';
import { CalendarDays, ArrowRight } from 'lucide-react';
import { business } from '../../data/business';
import heroImage from '../../assets/images/services/thermostat.jpg';
import { buildBreadcrumbSchema } from '../../lib/schema';

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const posts = allPosts.sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());

const categories = [...new Set(posts.map((p) => p.data.category))].sort();

/** The category chips link to `#<slug>`. Those ids have to actually exist:
 * the grid used to be one flat list, so every chip was a link to nowhere.
 * Slugify once here and reuse it for both the chip href and the section id
 * so the two can never drift apart again. */
function categoryId(category: string) {
  return category.toLowerCase().replace(/[^a-z0-9]+/g, '-');
}

const postsByCategory = categories.map((category) => ({
  category,
  id: categoryId(category),
  items: posts.filter((p) => p.data.category === category)
}));

const breadcrumbSchema = buildBreadcrumbSchema([
  { name: 'Home', path: '/' },
  { name: 'Blog', path: '/blog/' }
]);

function formatDate(d: Date) {
  return d.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });
}
---

<BaseLayout
  title={`Blog | ${business.name}`}
  description="Plumbing, HVAC, and electrical tips and guides for Colorado Springs homeowners from Affordable Plumbing, Heat & Electrical."
  schema={[breadcrumbSchema]}
>
  <PageHero
    title="Homeowner Tips & Guides"
    description="Practical plumbing, heating, cooling, and electrical advice for Colorado Springs homes."
    crumbs={[{ label: 'Home', href: '/' }, { label: 'Blog' }]}
    image={heroImage}
    imageAlt="Smart thermostat"
  />

  <section class="bg-white py-16 sm:py-24">
    <Container>
      {
        categories.length > 0 && (
          <div class="mb-10 flex flex-wrap gap-2" data-reveal>
            {categories.map((cat) => (
              <a
                href={`#${categoryId(cat)}`}
                class="border-ink-200 text-ink-600 hover:border-orange-400 hover:text-orange-600 inline-flex min-h-11 items-center rounded-full border bg-white px-4 text-xs font-semibold transition-colors"
              >
                {cat}
              </a>
            ))}
          </div>
        )
      }

      {
        postsByCategory.map(({ category, id, items }) => (
          <section id={id} class="scroll-mt-32 not-first:mt-14">
            <h2 class="font-display text-ink-900 mb-6 text-2xl font-bold">{category}</h2>
            <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
              {items.map((post) => (
                <article data-reveal class="card-elevated group flex flex-col p-6">
                  <h3 class="font-display text-ink-900 text-lg leading-snug font-bold">
                    <a href={`/blog/${post.id}/`} class="transition-colors hover:text-orange-600">
                      {post.data.title}
                    </a>
                  </h3>
                  <p class="text-ink-500 mt-2.5 flex-1 text-sm leading-relaxed">{post.data.description}</p>
                  <div class="border-ink-100 mt-5 flex items-center justify-between border-t pt-4">
                    <span class="text-ink-400 flex items-center gap-1.5 text-xs">
                      <CalendarDays className="size-3.5" aria-hidden="true" />
                      {formatDate(post.data.publishDate)}
                    </span>
                    <a
                      href={`/blog/${post.id}/`}
                      class="inline-flex min-h-11 items-center gap-1 text-xs font-bold text-orange-600 group-hover:text-orange-700"
                    >
                      Read <ArrowRight className="size-3.5" aria-hidden="true" />
                    </a>
                  </div>
                </article>
              ))}
            </div>
          </section>
        ))
      }

      {
        posts.length === 0 && (
          <p class="text-ink-500 py-20 text-center">New posts are on the way. Check back soon.</p>
        )
      }
    </Container>
  </section>

  <ContactCTA />
</BaseLayout>
