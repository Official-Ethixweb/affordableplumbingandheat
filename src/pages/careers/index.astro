---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/ui/Container.astro';
import Button from '../../components/ui/Button.astro';
import Breadcrumbs from '../../components/ui/Breadcrumbs.astro';
import { CheckCircle2, Mail, Phone } from 'lucide-react';
import { business } from '../../data/business';
import { buildBreadcrumbSchema } from '../../lib/schema';

const breadcrumbSchema = buildBreadcrumbSchema([
  { name: 'Home', path: '/' },
  { name: 'Careers', path: '/careers/' }
]);

const reasons = [
  'Work alongside licensed, experienced plumbing, HVAC, and electrical professionals',
  'Steady, year-round work serving Colorado Springs and the surrounding area',
  'A team that values honest work and treating customers right'
];
---

<BaseLayout
  title={`Careers | ${business.name}`}
  description="Work for Affordable Plumbing, Heat & Electrical in Colorado Springs, CO. Reach out to learn about current opportunities."
  schema={[breadcrumbSchema]}
>
  <section class="bg-white py-20 sm:py-28">
    <Container class="mx-auto max-w-3xl text-center">
      <Breadcrumbs crumbs={[{ label: 'Home', href: '/' }, { label: 'Careers' }]} center class="mb-3" />
      <p class="font-display text-xs font-bold tracking-wider text-orange-600 uppercase">Join Our Team</p>
      <h1 class="font-display text-ink-900 mt-3 text-4xl font-bold sm:text-5xl">
        Work For Affordable Plumbing, Heat &amp; Electrical
      </h1>
      <p class="text-ink-600 mx-auto mt-5 max-w-xl text-lg leading-relaxed">
        We're always interested in hearing from skilled, reliable plumbing, HVAC, and electrical professionals in the
        Colorado Springs area.
      </p>

      <ul class="mx-auto mt-10 max-w-lg space-y-3 text-left">
        {
          reasons.map((r) => (
            <li class="border-ink-100 text-ink-700 shadow-card flex items-start gap-3 rounded-2xl border bg-white px-5 py-4 text-sm">
              <CheckCircle2 className="mt-0.5 size-5 shrink-0 text-orange-600" aria-hidden="true" />
              {r}
            </li>
          ))
        }
      </ul>

      <p class="text-ink-500 mt-10 text-sm">
        Interested in joining the team? Send us your resume and a bit about your experience.
      </p>
      <div class="mt-5 flex flex-wrap justify-center gap-3">
        <Button href={`mailto:${business.email}?subject=${encodeURIComponent('Career Inquiry')}`} size="lg" icon={Mail}>
          {business.email}
        </Button>
        <Button href={`tel:${business.hotline.tel}`} variant="outline" size="lg" icon={Phone}>
          {business.hotline.display}
        </Button>
      </div>
    </Container>
  </section>
</BaseLayout>
