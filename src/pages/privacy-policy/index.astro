---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/ui/Container.astro';
import Breadcrumbs from '../../components/ui/Breadcrumbs.astro';
import { business } from '../../data/business';
import { buildBreadcrumbSchema } from '../../lib/schema';

const lastUpdated = 'August 2, 2026';

const breadcrumbSchema = buildBreadcrumbSchema([
  { name: 'Home', path: '/' },
  { name: 'Privacy Policy', path: '/privacy-policy/' }
]);
---

<BaseLayout
  title={`Privacy Policy | ${business.name}`}
  description={`How ${business.name} collects, uses, and protects your information.`}
  schema={[breadcrumbSchema]}
>
  <section class="bg-white py-20 sm:py-28">
    <Container class="mx-auto max-w-3xl">
      <Breadcrumbs crumbs={[{ label: 'Home', href: '/' }, { label: 'Privacy Policy' }]} class="mb-3" />
      <p class="font-display text-xs font-bold tracking-wider text-orange-600 uppercase">Legal</p>
      <h1 class="font-display text-ink-900 mt-3 text-4xl font-bold">Privacy Policy</h1>
      <p class="text-ink-500 mt-2 text-sm">Last updated: {lastUpdated}</p>

      <div class="text-ink-600 mt-10 space-y-8 text-[15px] leading-relaxed">
        <p>
          This Privacy Policy outlines our policies and procedures regarding the collection, use, and disclosure of
          your information when you use our website or request service from us. It also informs you about your
          privacy rights and how the law protects you. By using our website, you agree to the collection and use of
          information in accordance with this Privacy Policy.
        </p>

        <div>
          <h2 class="font-display text-ink-900 text-xl font-bold">Definitions</h2>
          <ul class="mt-3 list-disc space-y-2 pl-5">
            <li>
              <strong>Company</strong> ("we," "us," or "our") refers to {business.legalName}.
            </li>
            <li>
              <strong>Website</strong> refers to {business.url}.
            </li>
            <li>
              <strong>Personal Data</strong> is any information that relates to an identified or identifiable
              individual.
            </li>
            <li>
              <strong>Usage Data</strong> is data collected automatically, generated by use of the website or from
              the website's infrastructure (for example, the duration of a page visit).
            </li>
            <li><strong>You</strong> means the individual accessing or using the website.</li>
          </ul>
        </div>

        <div>
          <h2 class="font-display text-ink-900 text-xl font-bold">Information We Collect</h2>
          <p class="mt-3">
            When you request an estimate, fill out our contact form, use our chat assistant, or call our office, we
            may collect your name, phone number, email address, service address, and details about the plumbing,
            HVAC, or electrical issue you're contacting us about.
          </p>
          <p class="mt-3">
            Our website also automatically collects standard technical information such as your IP address, browser
            type, device type, and pages visited, typically through analytics tools, so we can understand how
            visitors use our site and improve performance.
          </p>
        </div>

        <div>
          <h2 class="font-display text-ink-900 text-xl font-bold">Cookies &amp; Tracking Technologies</h2>
          <p class="mt-3">
            We may use cookies and similar tracking technologies to track activity on our website and store certain
            information. You can instruct your browser to refuse all cookies or to indicate when a cookie is being
            sent; if you do not accept cookies, some parts of our website may not function as intended.
          </p>
        </div>

        <div>
          <h2 class="font-display text-ink-900 text-xl font-bold">How We Use Your Information</h2>
          <ul class="mt-3 list-disc space-y-2 pl-5">
            <li>To respond to service requests, estimates, and inquiries</li>
            <li>To schedule and dispatch technicians</li>
            <li>To send appointment confirmations or follow-up communications</li>
            <li>To comply with legal obligations</li>
            <li>To improve our website and services</li>
          </ul>
        </div>

        <div>
          <h2 class="font-display text-ink-900 text-xl font-bold">How We Share Information</h2>
          <p class="mt-3">
            We do not sell your personal information. We may share information with service providers who help us
            operate our business (such as scheduling, email, or payment platforms), when required by law, or in
            connection with a business transaction such as a merger or sale of assets.
          </p>
        </div>

        <div>
          <h2 class="font-display text-ink-900 text-xl font-bold">Retention &amp; Security</h2>
          <p class="mt-3">
            We retain personal data only as long as necessary for the purposes set out in this policy, or as required
            by law. No method of transmission over the internet or electronic storage is 100% secure, but we take
            reasonable steps to protect your information.
          </p>
        </div>

        <div>
          <h2 class="font-display text-ink-900 text-xl font-bold">Your Choices</h2>
          <p class="mt-3">
            You may contact us at any time to ask what information we have on file, request a correction, or ask that
            we delete it, subject to any recordkeeping we're required to retain for business or legal reasons.
          </p>
        </div>

        <div>
          <h2 class="font-display text-ink-900 text-xl font-bold">Contact Us</h2>
          <p class="mt-3">
            Questions about this policy can be sent to{' '}
            <a href={`mailto:${business.email}`} class="text-orange-600 underline underline-offset-2 hover:text-orange-700">
              {business.email}
            </a>{' '}
            or by calling {business.hotline.display}.
          </p>
        </div>
      </div>
    </Container>
  </section>
</BaseLayout>
