---
import { Phone, Clock, ChevronDown, Menu, X, Tag, Accessibility } from 'lucide-react';
import Container from '../ui/Container.astro';
import Button from '../ui/Button.astro';
import { business } from '../../data/business';
import { services, categoryMeta, type ServiceCategory } from '../../data/services';
import { coupons } from '../../data/coupons';
import logo from '../../assets/images/brand/logo.png';
import { Image } from 'astro:assets';

const categories: ServiceCategory[] = ['plumbing', 'hvac', 'electrical', 'sewer'];

const navLinks = [
  { label: 'Service Area', href: '/service-area/' },
  { label: 'About Us', href: '/about-us/' },
  { label: 'Blog', href: '/blog/' },
  { label: 'Coupons', href: '/coupons/' },
  { label: 'Financing', href: '/financing/' },
  { label: 'Contact Us', href: '/contact-us/' }
];

/** Destinations the service-category lists don't cover. The mobile dialog
 * renders these above the category lists so a phone visitor can still reach
 * Home, the services index and Careers - none of which appear anywhere else
 * in that menu. */
const mobileTopLinks = [
  { label: 'Home', href: '/' },
  { label: 'All Services', href: '/services/' }
];
const mobileExtraLinks = [{ label: 'Careers', href: '/careers/' }];

/** Nothing marked the current page before: no `aria-current`, no highlight.
 * Compared with a trailing slash on both sides so `/blog` and `/blog/` match,
 * and the section (not just the exact page) lights up - a visitor reading
 * /services/ac-repair-colorado-springs/ is still "in" Services. Home is the
 * exception: every path starts with "/", so it only matches exactly. */
const currentPath = Astro.url.pathname.replace(/\/?$/, '/');
function isCurrent(href: string) {
  const target = href.replace(/\/?$/, '/');
  return target === '/' ? currentPath === '/' : currentPath.startsWith(target);
}
const servicesSectionActive = currentPath.startsWith('/services/');
---

<header id="site-header" class="fixed inset-x-0 top-0 z-50">
  <!-- Utility bar -->
  <div class="hidden bg-navy-950 text-white/70 lg:block">
    <Container class="flex h-9 items-center justify-between text-[13px]">
      <p class="flex items-center gap-1.5 font-medium text-white/80">
        <Clock className="size-3.5 text-orange-400" aria-hidden="true" />
        {business.hoursShort} - Licensed &amp; Insured
      </p>
      <a
        href={`tel:${business.hotline.tel}`}
        class="inline-flex min-h-11 items-center font-semibold text-white/90 transition-colors hover:text-orange-400"
      >
        {business.hotline.display}
      </a>
    </Container>
  </div>

  <!-- Main nav -->
  <div id="main-nav" class="border-b border-white/5 bg-navy-900/95 backdrop-blur-xl transition-shadow duration-300">
    <Container class="flex h-[76px] items-center justify-between gap-4">
      <a href="/" class="shrink-0" aria-label={`${business.name} - Home`}>
        {/* quality 82, not "max": the logo renders at ~184x77 CSS px, where
            "max" bought 44.5KB of detail no one can resolve. */}
        <Image
          src={logo}
          alt={business.name}
          width={210}
          height={88}
          densities={[1, 2]}
          quality={82}
          class="h-11 w-auto sm:h-12"
          loading="eager"
          fetchpriority="high"
        />
      </a>

      <nav aria-label="Primary" class="hidden shrink-0 items-center lg:flex xl:gap-1">
        <details class="group relative shrink-0">
          <summary
            class:list={[
              'font-display flex shrink-0 cursor-pointer list-none items-center gap-1 rounded-full px-3 py-2.5 text-sm font-semibold whitespace-nowrap transition-colors hover:bg-white/5 hover:text-orange-300 xl:px-4 xl:text-[15px] [&::-webkit-details-marker]:hidden',
              servicesSectionActive ? 'bg-white/10 text-orange-300' : 'text-white/90'
            ]}
          >
            Services
            <ChevronDown
              className="size-4 transition-transform duration-300 group-open:rotate-180"
              aria-hidden="true"
            />
          </summary>
          <!-- Anchored to the trigger's left edge rather than centred on it:
               the "Services" summary sits near the left of the 1280px
               container, so a centred 720px panel pushed its first column
               ~100px off the left edge of a 1280px viewport, clipping the
               Plumbing links. Clamping the width to the viewport keeps it
               inside the screen on every size between lg and ultrawide. -->
          <div
            class="border-ink-100 absolute top-[calc(100%+12px)] left-0 w-[min(720px,calc(100vw-2rem))] rounded-3xl border bg-white p-4 shadow-2xl shadow-black/10"
          >
            <div class="grid grid-cols-4 gap-4">
              {
                categories.map((cat) => (
                  <div>
                    <p class="text-ink-400 mb-2 px-2 text-xs font-bold tracking-wider uppercase">
                      {categoryMeta[cat].label}
                    </p>
                    <div class="grid gap-0.5">
                      {services
                        .filter((s) => s.category === cat)
                        .slice(0, 6)
                        .map((s) => (
                          <a
                            href={`/services/${s.slug}/`}
                            aria-current={isCurrent(`/services/${s.slug}/`) ? 'page' : undefined}
                            class:list={[
                              'hover:bg-ink-50 rounded-xl px-2 py-1.5 text-[13px] leading-snug font-medium transition-colors',
                              isCurrent(`/services/${s.slug}/`) ? 'bg-orange-50 text-orange-700' : 'text-ink-700'
                            ]}
                          >
                            {s.title}
                          </a>
                        ))}
                    </div>
                  </div>
                ))
              }
            </div>
            <a
              href="/services/"
              class="font-display mt-3 flex items-center justify-center rounded-2xl bg-orange-600/10 px-4 py-3 text-sm font-semibold text-orange-600 transition-colors hover:bg-orange-600/15"
            >
              View All Services
            </a>
          </div>
        </details>

        {
          navLinks.map((link) => (
            <a
              href={link.href}
              aria-current={isCurrent(link.href) ? 'page' : undefined}
              class:list={[
                'font-display shrink-0 rounded-full px-3 py-2.5 text-sm font-semibold whitespace-nowrap transition-colors hover:bg-white/5 hover:text-orange-300 xl:px-4 xl:text-[15px]',
                isCurrent(link.href) ? 'bg-white/10 text-orange-300' : 'text-white/90'
              ]}
            >
              {link.label}
            </a>
          ))
        }
      </nav>

      <div class="flex items-center gap-2 sm:gap-3">
        <div class="hidden sm:inline-flex">
          <Button href="/contact-us/" size="md">Request Service</Button>
        </div>
        <a
          href={`tel:${business.hotline.tel}`}
          class="font-display hidden min-h-11 items-center gap-2 rounded-full border border-white/15 px-4 py-2.5 text-sm font-bold whitespace-nowrap text-white transition-colors hover:border-orange-400/50 hover:text-orange-300 md:flex lg:hidden xl:flex"
        >
          <Phone className="size-4 text-orange-400" aria-hidden="true" />
          {business.hotline.display}
        </a>

        <button
          id="mobile-menu-trigger"
          type="button"
          aria-haspopup="dialog"
          aria-controls="mobile-menu"
          aria-label="Open menu"
          class="inline-flex size-11 items-center justify-center rounded-full text-white transition-colors hover:bg-white/10 lg:hidden"
        >
          <Menu className="size-6" aria-hidden="true" />
        </button>
      </div>
    </Container>
  </div>
</header>

<!-- Mobile menu -->
<!-- h-svh, not h-dvh: `dvh` tracks iOS Safari's collapsing toolbar, so the
     panel resized under the reader's thumb mid-scroll. `svh` is the smallest
     viewport height, which never changes; the backdrop covers the strip the
     toolbar leaves behind when it retracts. -->
<dialog
  id="mobile-menu"
  aria-label="Mobile menu"
  class="m-0 h-svh max-h-none w-full max-w-none border-0 bg-navy-900 p-0 backdrop:bg-black/60 backdrop:backdrop-blur-sm open:flex open:flex-col"
>
  <div class="flex h-16 items-center justify-between border-b border-white/10 px-5">
    <Image src={logo} alt={business.name} width={170} height={71} densities={[1, 2]} quality={82} class="h-9 w-auto" />
    <button
      id="mobile-menu-close"
      type="button"
      aria-label="Close menu"
      class="inline-flex size-11 items-center justify-center rounded-full text-white hover:bg-white/10"
    >
      <X className="size-6" aria-hidden="true" />
    </button>
  </div>
  <nav aria-label="Mobile" class="flex-1 overflow-y-auto px-5 py-6">
    <button
      id="mobile-coupons-trigger"
      type="button"
      class="font-display mb-4 flex w-full items-center gap-2.5 rounded-2xl border border-white/15 bg-gradient-to-r from-orange-600/25 to-orange-600/5 px-4 py-3 text-sm font-bold text-white transition-colors hover:from-orange-600/35"
    >
      <Tag className="size-4 shrink-0 text-orange-300" aria-hidden="true" />
      Coupons &amp; Offers
      <span class="ml-auto flex size-6 shrink-0 items-center justify-center rounded-full bg-white/15 text-xs font-bold">
        {coupons.length}
      </span>
    </button>
    <button
      id="mobile-a11y-trigger"
      type="button"
      class="font-display mb-4 flex w-full items-center gap-2.5 rounded-2xl border border-white/15 bg-white/5 px-4 py-3 text-sm font-bold text-white transition-colors hover:bg-white/10"
    >
      <Accessibility className="size-4 shrink-0 text-orange-300" aria-hidden="true" />
      Accessibility
    </button>

    <ul class="mb-4 space-y-1">
      {
        mobileTopLinks.map((link) => (
          <li>
            <a
              href={link.href}
              aria-current={isCurrent(link.href) ? 'page' : undefined}
              class:list={[
                'font-display flex min-h-11 items-center rounded-xl px-3 py-3 text-base font-semibold hover:bg-white/5',
                isCurrent(link.href) ? 'bg-white/10 text-orange-300' : 'text-white'
              ]}
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>

    {
      categories.map((cat) => (
        <div class="mb-4">
          <p class="font-display px-2 pb-2 text-xs font-bold tracking-wider text-white/50 uppercase">
            {categoryMeta[cat].label}
          </p>
          <ul class="grid grid-cols-1 gap-0.5">
            {services
              .filter((s) => s.category === cat)
              .map((s) => (
                <li>
                  <a
                    href={`/services/${s.slug}/`}
                    aria-current={isCurrent(`/services/${s.slug}/`) ? 'page' : undefined}
                    class:list={[
                      'flex min-h-11 items-center rounded-xl px-3 py-3 text-sm font-medium hover:bg-white/5',
                      isCurrent(`/services/${s.slug}/`) ? 'bg-white/10 text-orange-300' : 'text-white/85'
                    ]}
                  >
                    {s.title}
                  </a>
                </li>
              ))}
          </ul>
        </div>
      ))
    }
    <div class="my-4 h-px bg-white/10"></div>
    <ul class="space-y-1">
      {
        [...navLinks, ...mobileExtraLinks].map((link) => (
          <li>
            <a
              href={link.href}
              aria-current={isCurrent(link.href) ? 'page' : undefined}
              class:list={[
                'font-display flex min-h-11 items-center rounded-xl px-3 py-3 text-base font-semibold hover:bg-white/5',
                isCurrent(link.href) ? 'bg-white/10 text-orange-300' : 'text-white'
              ]}
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
  <div class="space-y-3 border-t border-white/10 p-5">
    <Button href="/contact-us/" size="lg" class="w-full">Request Service</Button>
    <Button href={`tel:${business.hotline.tel}`} variant="secondary" size="lg" class="w-full"
      >Call {business.hotline.display}</Button
    >
  </div>
</dialog>

<script>
  const header = document.getElementById('site-header');
  const nav = document.getElementById('main-nav');
  const menu = document.getElementById('mobile-menu') as HTMLDialogElement | null;
  const openBtn = document.getElementById('mobile-menu-trigger');
  const closeBtn = document.getElementById('mobile-menu-close');
  const couponsTrigger = document.getElementById('mobile-coupons-trigger');
  const a11yTrigger = document.getElementById('mobile-a11y-trigger');

  const onScroll = () => {
    if (!nav) return;
    nav.classList.toggle('shadow-lg', window.scrollY > 8);
    nav.classList.toggle('shadow-black/20', window.scrollY > 8);
  };
  document.addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  // `aria-expanded` has to be maintained by hand: the trigger is a plain
  // button pointing at a <dialog>, so nothing updates it for us. Every close
  // path goes through closeMenu() rather than relying on the dialog's `close`
  // event alone - Escape and backdrop dismissal are the only routes that
  // can't call it directly, and the listener below covers those.
  const setExpanded = (value: boolean) => openBtn?.setAttribute('aria-expanded', String(value));
  const openMenu = () => {
    menu?.showModal();
    setExpanded(true);
  };
  const closeMenu = () => {
    menu?.close();
    setExpanded(false);
  };

  setExpanded(false);
  menu?.addEventListener('close', () => setExpanded(false));
  menu?.addEventListener('cancel', () => setExpanded(false));

  openBtn?.addEventListener('click', openMenu);
  closeBtn?.addEventListener('click', closeMenu);
  menu?.addEventListener('click', (e) => {
    if (e.target === menu) closeMenu();
  });
  menu?.querySelectorAll('a').forEach((a) => a.addEventListener('click', closeMenu));
  couponsTrigger?.addEventListener('click', () => {
    closeMenu();
    window.dispatchEvent(new CustomEvent('open-coupon-widget'));
  });
  a11yTrigger?.addEventListener('click', () => {
    closeMenu();
    window.dispatchEvent(new CustomEvent('open-a11y-panel'));
  });

  // Close open desktop dropdowns when clicking outside them.
  document.addEventListener('click', (e) => {
    document.querySelectorAll('nav[aria-label="Primary"] details[open]').forEach((d) => {
      if (!d.contains(e.target as Node)) d.removeAttribute('open');
    });
  });

  void header;
</script>
