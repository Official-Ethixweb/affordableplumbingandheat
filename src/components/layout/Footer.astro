---
import { Phone, Mail, MapPin, Clock } from 'lucide-react';
import Container from '../ui/Container.astro';
import SocialIcon from '../ui/SocialIcon.astro';
import { business } from '../../data/business';
import { services, categoryMeta, type ServiceCategory } from '../../data/services';
import logo from '../../assets/images/brand/logo.png';
import energyStarBadge from '../../assets/images/badges/energy-star.png';
import equalHousingBadge from '../../assets/images/badges/equal-housing-lender.png';
import { Image } from 'astro:assets';

const categories: ServiceCategory[] = ['plumbing', 'hvac', 'electrical', 'sewer'];
const trustBadges = [
  { name: 'Energy Star Partner', image: energyStarBadge },
  { name: 'Equal Housing Lender', image: equalHousingBadge }
];

const year = new Date().getFullYear();
const companyLinks = [
  { label: 'About Us', href: '/about-us/' },
  { label: 'Our Services', href: '/services/' },
  { label: 'Service Area', href: '/service-area/' },
  { label: 'Financing', href: '/financing/' },
  { label: 'Coupons', href: '/coupons/' },
  { label: 'Careers', href: '/careers/' },
  { label: 'Blog', href: '/blog/' },
  { label: 'Contact Us', href: '/contact-us/' },
  { label: 'Accessibility', href: '/accessibility/' },
  { label: 'Privacy Policy', href: '/privacy-policy/' }
];
---

<!-- No closing CTA here: ContactCTA.astro is rendered by the pages themselves
     and sits directly above this footer, so a second heading-plus-two-buttons
     block repeated the same offer and the same phone number twice in a row. -->
<!-- The border matters: ContactCTA is also navy-900, so without it the two
     would merge into one undifferentiated navy field. -->
<footer class="bg-navy-900 border-t border-white/10 text-white/60">
  <Container class="grid grid-cols-2 gap-x-8 gap-y-12 py-16 sm:grid-cols-2 lg:grid-cols-[1.3fr_1fr_1fr_1.1fr]">
    <div class="col-span-2 lg:col-span-1">
      <a href="/" aria-label={`${business.name} - Home`} class="inline-flex min-h-11 items-center">
        <Image
          src={logo}
          alt={business.name}
          width={190}
          height={80}
          densities={[1, 2]}
          quality="max"
          class="h-10 w-auto"
        />
      </a>
      <p class="mt-4 max-w-xs text-sm leading-relaxed text-white/60">
        Colorado Springs' trusted plumbing, heating, cooling &amp; electrical company. Honest pricing, licensed
        technicians, available 24/7.
      </p>
      <div class="mt-5 flex items-center gap-2.5">
        <SocialIcon network="facebook" href={business.social.facebook} />
      </div>
      <div class="mt-6 flex items-center gap-4">
        {
          trustBadges.map((badge) => (
            <Image
              src={badge.image}
              alt={badge.name}
              width={100}
              height={42}
              class="h-10 w-auto rounded bg-white/95 p-1"
              loading="lazy"
            />
          ))
        }
      </div>
    </div>

    <div>
      <h2 class="font-display text-sm font-bold tracking-wider text-white uppercase">Services</h2>
      {
        categories.map((cat) => (
          <div class="mt-4">
            {/* white/55 not /40: at 40% these labels were 3.76:1 on navy-900, below AA. */}
            <p class="text-xs font-semibold tracking-wide text-white/55 uppercase">{categoryMeta[cat].label}</p>
            <ul class="mt-1">
              {services
                .filter((s) => s.category === cat)
                .slice(0, 4)
                .map((s) => (
                  <li>
                    <a
                      href={`/services/${s.slug}/`}
                      class="flex min-h-11 items-center text-sm text-white/60 transition-colors hover:text-orange-400"
                    >
                      {s.title}
                    </a>
                  </li>
                ))}
            </ul>
          </div>
        ))
      }
    </div>

    <div>
      <h2 class="font-display text-sm font-bold tracking-wider text-white uppercase">Company</h2>
      <ul class="mt-1">
        {
          companyLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="flex min-h-11 items-center text-sm text-white/60 transition-colors hover:text-orange-400"
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="col-span-2 sm:col-span-1">
      <h2 class="font-display text-sm font-bold tracking-wider text-white uppercase">Get In Touch</h2>
      <ul class="mt-2 text-sm">
        <li>
          <a
            href={`tel:${business.hotline.tel}`}
            class="flex min-h-11 items-center gap-1.5 font-semibold text-white hover:text-orange-400"
          >
            <Phone className="size-3.5 text-orange-400" aria-hidden="true" />
            {business.hotline.display}
          </a>
        </li>
        <li>
          <a
            href={`mailto:${business.email}`}
            class="flex min-h-11 items-center gap-1.5 text-white/60 hover:text-orange-400"
          >
            <Mail className="size-3.5 text-orange-400" aria-hidden="true" />
            {business.email}
          </a>
        </li>
      </ul>
      <p class="mt-4 flex items-center gap-1.5 text-sm text-white/60">
        <Clock className="size-3.5 text-orange-400" aria-hidden="true" />
        {business.hours}
      </p>
      <p class="mt-1.5 flex items-start gap-1.5 text-sm text-white/60">
        <MapPin className="mt-0.5 size-3.5 shrink-0 text-orange-400" aria-hidden="true" />
        {business.streetAddress}, {business.addressLocality}, {business.addressRegion}
        {business.postalCode}
      </p>
    </div>
  </Container>

  <div class="border-t border-white/5 py-6">
    <Container
      class="flex flex-col items-center gap-2 text-center text-xs text-white/60 sm:flex-row sm:justify-between sm:text-left"
    >
      <p>&copy; {year} {business.legalName}. All rights reserved.</p>
      <p>
        License #{business.license.electrical} &nbsp;·&nbsp; License #{business.license.plumbing} &nbsp;·&nbsp; License #{
          business.license.mechanical
        }
      </p>
    </Container>
  </div>
</footer>
