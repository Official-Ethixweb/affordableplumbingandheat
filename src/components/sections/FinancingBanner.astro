---
import { Sparkles, ArrowRight } from 'lucide-react';
import Container from '../ui/Container.astro';
---

<div class="bg-orange-600">
  <Container class="flex flex-col items-center justify-center gap-2 py-4 text-center sm:flex-row sm:gap-3">
    <p class="font-display flex items-center gap-2 text-sm font-bold text-white sm:text-base">
      <Sparkles className="size-4" aria-hidden="true" />
      Financing Available: Fix It Now, Pay Over Time
    </p>
    <a href="/financing/" class="inline-flex min-h-11 items-center gap-1 text-sm font-bold text-white underline underline-offset-2 hover:text-white/85">
      See options <ArrowRight className="size-3.5" aria-hidden="true" />
    </a>
  </Container>
</div>
