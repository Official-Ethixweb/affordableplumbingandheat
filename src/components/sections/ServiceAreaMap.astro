---
/**
 * Premium interactive Colorado service-area map.
 *
 * The map is generated entirely in code. Every path is projected at BUILD
 * time from a real public-domain dataset by
 * scripts/generate-service-area-map.mjs, which writes the static strings in
 * src/data/serviceAreaMap.generated.ts:
 *
 *  • State + county boundaries — US Census cartographic boundaries (us-atlas)
 *  • Rivers, lakes, highways    — Natural Earth 10m physical/cultural vectors
 *  • Terrain relief             — hypsometric contour bands traced by marching
 *                                 squares over a real 300x190 NOAA NCEI
 *                                 elevation grid
 *  • Markers                    — the canonical serviceAreas lat/lng in
 *                                 src/data/business.ts, same projection
 *
 * Nothing is hand-drawn or eyeballed: an earlier revision authored "terrain"
 * as invented polygons and it read as random shapes on an empty field. If the
 * geography needs changing, change the dataset or the generator — never nudge
 * a path by hand.
 *
 * No mapping library, GeoJSON or TopoJSON reaches the browser; only the
 * generated path strings, which are plain markup.
 *
 * Two visual variants, one shared marker/tooltip/data engine:
 *  - `variant="full"` (default): the Service Area page — full relief map with
 *    legend, compass, shields and per-marker labels, paired with a
 *    "Communities We Serve" side panel. The bottom trust/CTA strip lives in
 *    TrustStrip.astro and is placed by the caller.
 *  - `variant="compact"`: the homepage — same geography and labels, but the
 *    legend and interstate shields are dropped so it reads cleanly smaller.
 *
 * Interaction is vanilla JS (see the inline <script> below): hover/focus a
 * marker to reveal a tooltip with a real link when a location page exists, or
 * a "Request Service" CTA when it doesn't. The crawlable "Communities We
 * Serve" list is real HTML outside the SVG — it, not the drawing, is the
 * accessible/indexable source of truth for coverage.
 */
import { MapPin, Phone } from 'lucide-react';
import { business, serviceAreas } from '../../data/business';
import { cityPages } from '../../data/cityPages';
import {
  MAP_HEIGHT,
  MAP_VIEW_BOX,
  MAP_WIDTH,
  coloradoPath,
  countyPath,
  coverageAreaPath,
  i25Path,
  i70Path,
  lakePath,
  otherInterstatePath,
  projectedMarkers,
  projectedReferences,
  reliefBands,
  ridgeLinesPath,
  riverPath,
  roadShields,
  usRoutePath
} from '../../data/serviceAreaMap.generated';

interface Props {
  variant?: 'full' | 'compact';
}
const { variant = 'full' } = Astro.props;
const isCompact = variant === 'compact';

const pagedSlugs = new Set(cityPages.map((c) => c.slug));

const primary = projectedMarkers.find((m) => m.type === 'primary')!;
const surrounding = projectedMarkers.filter((m) => m.type === 'surrounding');

function hrefFor(slug: string) {
  return pagedSlugs.has(slug) ? `/service-area/${slug}/` : '';
}

/** Destination for the text lists beside/below the map. A community with its
 * own hub page goes there; the primary market has no `[slug]` page of its own
 * so it points at the service-area overview (the same target its map marker
 * uses); anything else falls back to the enquiry form. */
function listHrefFor(area: { slug: string; type?: string }) {
  if (pagedSlugs.has(area.slug)) return `/service-area/${area.slug}/`;
  return area.type === 'primary' ? '/service-area/' : '/contact-us/';
}

/** Hypsometric tint ramp: low plains → high peaks. Sampled to feel like a
 * printed relief map rather than a heatmap — greens through tans to a pale
 * rock grey, matching the reference artwork's palette. Index-matched to
 * `reliefBands` (ascending elevation). */
const RELIEF_FILLS = [
  '#e4ebd9',
  '#d9e5cb',
  '#cddcbb',
  '#cfd8ac',
  '#d6d29e',
  '#d8c992',
  '#d3bd89',
  '#cbb185'
];

/** Colorado Springs sits in a genuinely dense real-world cluster — Cascade,
 * Manitou Springs, Woodland Park, Monument, Palmer Lake, Security, Widefield
 * and Fountain are all within a few map-miles of it and of each other. The
 * default "label centred above the dot" placement collides badly there, so
 * these get a hand-tuned offset + anchor that pushes each label outward,
 * away from the cluster centre. Every other marker uses the default. */
const LABEL_OVERRIDES: Record<string, { dx: number; dy: number; anchor: 'start' | 'middle' | 'end' }> = {
  'colorado-springs': { dx: 20, dy: 0, anchor: 'start' },
  // West of the primary market, pushed left so they clear the coverage shape.
  cascade: { dx: -16, dy: -3, anchor: 'end' },
  'manitou-springs': { dx: -16, dy: 10, anchor: 'end' },
  'woodland-park': { dx: -16, dy: 4, anchor: 'end' },
  'palmer-lake': { dx: -16, dy: 1, anchor: 'end' },
  // East / north-east of it, pushed right.
  monument: { dx: 16, dy: 4, anchor: 'start' },
  // Black Forest and Peyton sit almost level with each other; Black Forest
  // reads left so the two never overlap.
  'black-forest': { dx: -16, dy: 3, anchor: 'end' },
  falcon: { dx: 16, dy: 5, anchor: 'start' },
  peyton: { dx: 16, dy: 4, anchor: 'start' },
  security: { dx: 16, dy: 1, anchor: 'start' },
  widefield: { dx: 16, dy: 10, anchor: 'start' },
  fountain: { dx: 16, dy: 5, anchor: 'start' },
  'castle-rock': { dx: 16, dy: 4, anchor: 'start' },
  'highlands-ranch': { dx: 16, dy: 0, anchor: 'start' },
  parker: { dx: 16, dy: 5, anchor: 'start' }
};

function labelFor(slug: string) {
  return LABEL_OVERRIDES[slug] ?? { dx: 0, dy: -13, anchor: 'middle' as const };
}
---

<div class:list={['service-area-map-wrap', isCompact && 'is-compact']} data-reveal>
  <div class:list={['map-poster-grid', !isCompact && 'map-poster-grid--full']}>
    <!-- ============ MAP CARD ============ -->
    <div class="service-area-map card-elevated relative overflow-hidden bg-white p-4 sm:p-6">
      <!-- Every path below is projected at build time from a real
           public-domain dataset (US Census counties, Natural Earth rivers and
           roads, a NOAA elevation grid traced into hypsometric contour bands).
           See scripts/generate-service-area-map.mjs. Nothing here is
           hand-drawn, and no geodata reaches the browser - only these
           static strings. -->
      <div class="map-figure" style={`--map-ratio:${MAP_WIDTH} / ${MAP_HEIGHT}`}>
        <svg
          class="map-svg"
          viewBox={MAP_VIEW_BOX}
          role="img"
          aria-labelledby={`map-title-${variant} map-desc-${variant}`}
          preserveAspectRatio="xMidYMid meet"
        >
          <title id={`map-title-${variant}`}>
            Map of the {business.name} service area in Colorado
          </title>
          <desc id={`map-desc-${variant}`}>
            A relief map of Colorado showing {business.addressLocality} as the primary service market, with {
              surrounding.length
            } surrounding communities marked along the Front Range corridor. Denver is shown only as a geographic
            reference point. The full list of communities is available as text beside this map.
          </desc>

          <defs>
            <linearGradient id={`map-sky-${variant}`} x1="0%" y1="0%" x2="0%" y2="100%">
              <stop offset="0%" stop-color="#f4f2ea"></stop>
              <stop offset="100%" stop-color="#eceadf"></stop>
            </linearGradient>
            <radialGradient id={`coverage-fill-${variant}`} cx="45%" cy="45%" r="60%">
              <stop offset="0%" stop-color="var(--color-orange-400)" stop-opacity="0.5"></stop>
              <stop offset="100%" stop-color="var(--color-orange-500)" stop-opacity="0.34"></stop>
            </radialGradient>
            <filter id={`marker-shadow-${variant}`} x="-60%" y="-60%" width="220%" height="220%">
              <feDropShadow dx="0" dy="1.5" stdDeviation="1.4" flood-color="#0a1830" flood-opacity="0.3"></feDropShadow>
            </filter>
            <clipPath id={`state-clip-${variant}`}>
              <path d={coloradoPath}></path>
            </clipPath>
          </defs>

          <rect x="0" y="0" width={MAP_WIDTH} height={MAP_HEIGHT} fill={`url(#map-sky-${variant})`}></rect>

          <!-- Everything geographic is clipped to the real state boundary, so
               detail never bleeds outside Colorado. -->
          <g clip-path={`url(#state-clip-${variant})`}>
            <path d={coloradoPath} fill="#eef0e6"></path>

            <!-- Hypsometric relief: contour bands traced by marching squares
                 over a real NOAA elevation grid. This is the terrain. -->
            <g class="map-relief" aria-hidden="true">
              {
                reliefBands.map((band, i) => (
                  <path d={band.d} fill={RELIEF_FILLS[i] ?? RELIEF_FILLS[RELIEF_FILLS.length - 1]} />
                ))
              }
            </g>
            <path class="map-ridges" d={ridgeLinesPath} fill="none" aria-hidden="true"></path>

            <path class="map-counties" d={countyPath} fill="none" aria-hidden="true"></path>
            <path class="map-rivers" d={riverPath} fill="none" aria-hidden="true"></path>
            {lakePath && <path class="map-lakes" d={lakePath} aria-hidden="true" />}

            <!-- Real surveyed highway alignments from Natural Earth. -->
            <path class="map-road map-road--us" d={usRoutePath} fill="none" aria-hidden="true"></path>
            <path class="map-road map-road--interstate" d={otherInterstatePath} fill="none" aria-hidden="true"></path>
            <path class="map-road map-road--major" d={i70Path} fill="none" aria-hidden="true"></path>
            <path class="map-road map-road--major" d={i25Path} fill="none" aria-hidden="true"></path>

            <!-- Coverage region: a smoothed hull around the real projected
                 markers. Deliberately covers only the service corridor, never
                 the whole state. -->
            <path
              class="map-coverage"
              d={coverageAreaPath}
              fill={`url(#coverage-fill-${variant})`}
              stroke="var(--color-orange-600)"
              stroke-width="2.2"
              stroke-opacity="0.9"
              stroke-linejoin="round"></path>
          </g>

          <!-- State border sits above the clip so it reads as a crisp edge. -->
          <path
            class="map-outline"
            d={coloradoPath}
            fill="none"
            stroke="var(--color-navy-800)"
            stroke-width="2.4"
            stroke-linejoin="round"></path>

          <text x={MAP_WIDTH * 0.29} y={MAP_HEIGHT * 0.55} class="map-watermark" text-anchor="middle" aria-hidden="true">COLORADO</text>

          {
            !isCompact &&
              roadShields.map((s) => (
                <g class="map-shield" transform={`translate(${s.x} ${s.y})`} aria-hidden="true">
                  {/* Interstate shield: white outline, red crown, blue body —
                      the familiar badge, drawn as simple shapes rather than
                      official artwork. */}
                  <path
                    d="M0,-13 L11.5,-8.5 L11.5,3 C11.5,10 5.5,14.5 0,17 C-5.5,14.5 -11.5,10 -11.5,3 L-11.5,-8.5 Z"
                    fill="#ffffff"
                  />
                  <path
                    d="M0,-11 L9.7,-7.2 L9.7,-4.2 L-9.7,-4.2 L-9.7,-7.2 Z"
                    fill="#c8102e"
                  />
                  <path
                    d="M-9.7,-4.2 L9.7,-4.2 L9.7,2.6 C9.7,8.4 4.7,12.4 0,14.6 C-4.7,12.4 -9.7,8.4 -9.7,2.6 Z"
                    fill="#0b3c8c"
                  />
                  <text y="7" text-anchor="middle" class="map-shield-text">
                    {s.interstate.replace('I-', '')}
                  </text>
                </g>
              ))
          }

          <!-- Geographic reference only (Denver), never a service marker. -->
          {
            projectedReferences.map((ref) => (
              <g class="map-reference" transform={`translate(${ref.x} ${ref.y})`} aria-hidden="true">
                <circle r="4" fill="var(--color-navy-800)" />
                <circle r="4" fill="none" stroke="white" stroke-width="1.2" />
                <text x="8" y="4" class="map-reference-label">
                  {ref.name}
                </text>
              </g>
            ))
          }

          <!-- Surrounding service communities -->
          {
            surrounding.map((m, i) => {
              const hasPage = pagedSlugs.has(m.slug);
              const label = labelFor(m.slug);
              return (
                <g
                  class="map-marker map-marker--surrounding"
                  data-marker
                  data-name={m.name}
                  data-href={hrefFor(m.slug)}
                  data-has-page={hasPage ? '1' : '0'}
                  transform={`translate(${m.x} ${m.y})`}
                  tabindex="0"
                  role="button"
                  aria-label={`${m.name}, service community${hasPage ? ' - view service details' : ' - request service'}`}
                >
                  {/* Position lives on the outer <g>; the animation transform
                      lives on the inner one. An SVG `transform` attribute and a
                      CSS `transform` on the SAME element don't compose - the CSS
                      one would silently replace the translate and stack every
                      marker at the origin. */}
                  <g class="map-marker-inner" style={`--enter-delay:${90 + i * 40}ms`}>
                    <circle r="8.5" fill="white" filter={`url(#marker-shadow-${variant})`} />
                    <circle r="6.2" fill="var(--color-orange-500)" />
                    <text x={label.dx} y={label.dy} class="map-marker-label" text-anchor={label.anchor}>
                      {m.name}
                    </text>
                  </g>
                </g>
              );
            })
          }

          <!-- Primary market, drawn last so it sits above the cluster -->
          <g
            class="map-marker map-marker--primary"
            data-marker
            data-name={primary.name}
            data-href="/service-area/"
            data-has-page="0"
            data-primary="1"
            transform={`translate(${primary.x} ${primary.y})`}
            tabindex="0"
            role="button"
            aria-label={`${primary.name}, primary service market`}
          >
            <g class="map-marker-inner">
              <circle class="map-pulse" r="15" fill="var(--color-orange-500)" opacity="0.3"></circle>
              <circle r="14" fill="white" filter={`url(#marker-shadow-${variant})`}></circle>
              <circle r="11" fill="none" stroke="var(--color-orange-600)" stroke-width="3.2"></circle>
              <circle r="6" fill="var(--color-orange-600)"></circle>
              <text
                x={labelFor('colorado-springs').dx}
                y={labelFor('colorado-springs').dy - 6}
                class="map-marker-label map-marker-label--primary"
                text-anchor="start"
              >
                {primary.name}
              </text>
              <text
                x={labelFor('colorado-springs').dx}
                y={labelFor('colorado-springs').dy + 7}
                class="map-marker-sublabel"
                text-anchor="start"
              >
                Primary Market
              </text>
            </g>
          </g>
        </svg>

        {
          !isCompact && (
            <div class="map-legend" aria-hidden="true">
              <p class="map-legend-item">
                <span class="map-legend-dot map-legend-dot--primary" />
                <span>
                  <strong>Primary Market</strong>
                  <span class="map-legend-sub">{business.addressLocality}</span>
                </span>
              </p>
              <p class="map-legend-item">
                <span class="map-legend-dot map-legend-dot--surrounding" />
                <span>
                  <strong>Communities We Serve</strong>
                </span>
              </p>
              <p class="map-legend-item">
                <span class="map-legend-dot map-legend-dot--reference" />
                <span>
                  <strong>Major Reference City</strong>
                </span>
              </p>
            </div>
          )
        }

        <!-- Compass: a four-point rose with the north arm split light/dark,
             like the reference. Shown on both variants. -->
        <div class="map-compass" aria-hidden="true">
          <svg viewBox="0 0 44 52">
            <text x="22" y="9" text-anchor="middle" class="map-compass-n">N</text>
            <g transform="translate(22 30)">
              <!-- East / west / south arms, muted -->
              <path d="M0,0 L18,0 L0,4 Z" fill="var(--color-navy-400)"></path>
              <path d="M0,0 L-18,0 L0,4 Z" fill="var(--color-navy-600)"></path>
              <path d="M0,0 L4,0 L0,18 Z" fill="var(--color-navy-400)"></path>
              <path d="M0,0 L-4,0 L0,18 Z" fill="var(--color-navy-600)"></path>
              <!-- North arm, emphasised -->
              <path d="M0,0 L4,0 L0,-20 Z" fill="var(--color-navy-800)"></path>
              <path d="M0,0 L-4,0 L0,-20 Z" fill="var(--color-navy-600)"></path>
              <circle r="2.6" fill="var(--color-navy-900)"></circle>
            </g>
          </svg>
        </div>
      </div>


      <!-- Tooltip: positioned via JS on hover/focus. Kept outside the SVG so it
           can hold real interactive HTML (a real link or button). -->
      <div id={`map-tooltip-${variant}`} class="map-tooltip" role="tooltip" hidden>
        <p class="map-tooltip-city"></p>
        <p class="map-tooltip-business">{business.name}</p>
        <p class="map-tooltip-status">Service available in this area.</p>
        <!-- Real default rather than "#": showTooltip() swaps in the marker's
             own href before the tooltip is ever shown, but a literal "#" in
             the static markup reads as a dead link to crawlers and link
             checkers. /service-area/ is the correct fallback destination. -->
        <a class="map-tooltip-cta map-tooltip-cta--view" href="/service-area/">
          View Area
          <MapPin className="size-3.5" aria-hidden="true" />
        </a>
        <a class="map-tooltip-cta map-tooltip-cta--request" href="/contact-us/">
          Request Service
          <MapPin className="size-3.5" aria-hidden="true" />
        </a>
      </div>

      {
        /* The homepage map has no side panel, so on a phone the only route
           into a community was a marker roughly 6px across. These chips are
           the same destinations as real 44px-tall links; they drop away at lg
           where the markers are big enough to aim at. */
        isCompact && (
          <ul class="community-chips lg:hidden" aria-label="Communities we serve">
            {serviceAreas.map((area) => (
              <li>
                <a href={listHrefFor(area)} class="community-chip">
                  {area.name}
                </a>
              </li>
            ))}
          </ul>
        )
      }

      {
        isCompact && (
          <p class="text-ink-400 mt-4 flex items-center gap-1.5 text-center text-xs sm:justify-center">
            <Phone className="size-3.5 shrink-0" aria-hidden="true" />
            Don&rsquo;t see your town? Call {business.hotline.display} - there&rsquo;s a good chance we still cover
            you.
          </p>
        )
      }
    </div>

    {
      /* Communities side panel: real crawlable HTML, kept outside the SVG
         entirely — this is the primary a11y/SEO redundancy for the visual
         map. */
      !isCompact && (
        <aside class="communities-panel card-elevated overflow-hidden bg-white p-0" aria-label="Communities we serve">
          <div class="communities-panel-header">
            <MapPin className="size-4 shrink-0" aria-hidden="true" />
            <h3>Communities We Serve</h3>
          </div>
          <ul class="communities-panel-list">
            {serviceAreas.map((area) => (
              <li>
                {/* These were inert <li>s, which made the SVG pins the only
                    way to reach a community - and at 375px those pins render
                    ~6px across with 3px between the closest pair, far below a
                    finger's reach. The list is now the touch path. */}
                <a href={listHrefFor(area)} class="communities-panel-link">
                  <MapPin className="communities-panel-pin" aria-hidden="true" />
                  <span>
                    <span class="communities-panel-name">{area.name}</span>
                    <span class="communities-panel-blurb">{area.blurb}</span>
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </aside>
      )
    }
  </div>
</div>

<style>
  .map-poster-grid {
    display: grid;
    gap: 1.5rem;
  }

  @media (min-width: 1024px) {
    .map-poster-grid--full {
      grid-template-columns: minmax(0, 1fr) 340px;
      /* `stretch`, not `start`: the communities list is taller than the map
       * card, and starting both at the top left a large dead gap under the
       * map. Stretching lets the map card fill the row height and the list
       * scroll within it, so the two columns end level. */
      align-items: stretch;
    }

    .map-poster-grid--full > .service-area-map {
      display: flex;
      flex-direction: column;
      justify-content: center;
    }

    /* Cap the list to the row height and let it scroll — it holds 15 entries
     * and would otherwise dictate the whole section's height. */
    .map-poster-grid--full > .communities-panel {
      max-height: 100%;
      display: flex;
      flex-direction: column;
    }

    .map-poster-grid--full > .communities-panel .communities-panel-list {
      overflow-y: auto;
      min-height: 0;
    }
  }

  /* ---- Generated relief map surface ---- */

  .map-figure {
    position: relative;
    width: 100%;
    margin-inline: auto;
  }

  /* Scoped to .map-svg specifically — a bare `svg` selector would also
   * match the lucide <Phone>/<MapPin> icons elsewhere in this component and
   * blow them up to the map's dimensions. */
  .map-svg {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: var(--map-ratio, 1024 / 620);
    border-radius: 1rem;
    overflow: hidden;
  }

  /* --- Geographic layers --- */

  .map-relief path {
    opacity: 0;
    animation: map-fade-in 0.6s ease-out both;
  }

  .map-relief path:nth-child(1) { animation-delay: 0.05s; }
  .map-relief path:nth-child(2) { animation-delay: 0.09s; }
  .map-relief path:nth-child(3) { animation-delay: 0.13s; }
  .map-relief path:nth-child(4) { animation-delay: 0.17s; }
  .map-relief path:nth-child(5) { animation-delay: 0.21s; }
  .map-relief path:nth-child(6) { animation-delay: 0.25s; }
  .map-relief path:nth-child(7) { animation-delay: 0.29s; }
  .map-relief path:nth-child(8) { animation-delay: 0.33s; }

  .map-ridges {
    stroke: #b9b79c;
    stroke-width: 0.7;
    stroke-opacity: 0.5;
    stroke-linecap: round;
  }

  .map-counties {
    stroke: var(--color-navy-900);
    stroke-width: 0.5;
    stroke-opacity: 0.14;
  }

  .map-rivers {
    stroke: #8fb4cc;
    stroke-width: 0.9;
    stroke-opacity: 0.65;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .map-lakes {
    fill: #a9c8dc;
    fill-opacity: 0.6;
  }

  .map-road {
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .map-road--us {
    stroke: #c6bfae;
    stroke-width: 0.8;
    stroke-opacity: 0.75;
  }

  .map-road--interstate {
    stroke: #b3a894;
    stroke-width: 1.1;
    stroke-opacity: 0.8;
  }

  /* I-25 and I-70 read stronger — they frame the service corridor. */
  .map-road--major {
    stroke: #9a8f78;
    stroke-width: 1.7;
    stroke-opacity: 0.9;
  }

  .map-outline {
    opacity: 0;
    animation: map-fade-in 0.7s ease-out 0.02s both;
  }

  .map-coverage {
    opacity: 0;
    transform-box: fill-box;
    transform-origin: center;
    animation: coverage-enter 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.42s both;
  }

  .map-watermark {
    font-family: var(--font-display);
    font-size: 34px;
    font-weight: 800;
    letter-spacing: 0.3em;
    fill: var(--color-navy-800);
    fill-opacity: 0.42;
    /* Halo, same trick as the marker labels: the watermark sits over mottled
     * relief bands, and without it the letters muddy against the darker tans. */
    paint-order: stroke;
    stroke: #f6f4ec;
    stroke-width: 5px;
    stroke-opacity: 0.55;
    stroke-linejoin: round;
  }

  .map-shield {
    opacity: 0;
    animation: map-fade-in 0.5s ease-out 0.6s both;
  }

  .map-shield-text {
    font-family: var(--font-display);
    font-size: 11px;
    font-weight: 800;
    fill: white;
    letter-spacing: -0.02em;
  }

  .map-reference {
    opacity: 0;
    animation: map-fade-in 0.5s ease-out 0.66s both;
  }

  .map-reference-label {
    font-family: var(--font-body);
    font-size: 12px;
    font-weight: 600;
    fill: var(--color-navy-800);
    paint-order: stroke;
    stroke: #f4f2ea;
    stroke-width: 3px;
    stroke-linejoin: round;
  }

  /* --- Markers --- */

  .map-marker {
    cursor: pointer;
  }

  .map-marker-inner {
    opacity: 0;
    transform-box: fill-box;
    transform-origin: center;
    animation: marker-enter 0.5s cubic-bezier(0.16, 1, 0.3, 1) var(--enter-delay, 0.7s) both;
  }

  .map-marker--surrounding .map-marker-inner {
    transition: transform 0.2s ease-out;
  }

  .map-marker--primary .map-marker-inner {
    animation-delay: 0.8s;
  }

  .map-marker-label {
    font-family: var(--font-display);
    font-size: 12.5px;
    font-weight: 700;
    fill: var(--color-navy-900);
    paint-order: stroke;
    stroke: #f6f4ec;
    stroke-width: 3.5px;
    stroke-linejoin: round;
  }

  .map-marker-label--primary {
    font-size: 16px;
    font-weight: 800;
  }

  .map-marker-sublabel {
    font-family: var(--font-display);
    font-size: 9.5px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    fill: var(--color-orange-600);
    paint-order: stroke;
    stroke: #f6f4ec;
    stroke-width: 3.5px;
    stroke-linejoin: round;
  }

  .map-marker:hover .map-marker-inner,
  .map-marker:focus-visible .map-marker-inner {
    transform: scale(1.18);
  }

  .map-marker--primary:hover .map-marker-inner,
  .map-marker--primary:focus-visible .map-marker-inner {
    transform: scale(1.08);
  }

  .map-marker:focus-visible {
    outline: none;
  }

  .map-marker:focus-visible .map-marker-inner circle:nth-child(2) {
    stroke: var(--color-orange-600);
    stroke-width: 3.5px;
  }

  .map-pulse {
    transform-box: fill-box;
    transform-origin: center;
    animation: pulse-ring 2.6s cubic-bezier(0.4, 0, 0.6, 1) infinite;
  }

  @keyframes map-fade-in {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  /* Markers settle in rather than just fading: a slight overshoot reads as
   * pins being placed, which is what the reference's styling implies. */
  @keyframes marker-enter {
    0% { opacity: 0; transform: scale(0.2) translateY(-6px); }
    60% { opacity: 1; transform: scale(1.12) translateY(0); }
    100% { opacity: 1; transform: scale(1) translateY(0); }
  }

  /* The coverage region sweeps up from the primary market, so the eye lands
   * on Colorado Springs first and the footprint grows outward from it. */
  @keyframes coverage-enter {
    from { opacity: 0; transform: scale(0.9); }
    to { opacity: 1; transform: scale(1); }
  }

  @keyframes pulse-ring {
    0%, 100% { transform: scale(0.8); opacity: 0.32; }
    50% { transform: scale(1.45); opacity: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .map-relief path,
    .map-outline,
    .map-coverage,
    .map-shield,
    .map-reference,
    .map-compass,
    .map-marker-inner {
      animation: none !important;
      opacity: 1 !important;
      transform: none !important;
    }
    .map-pulse {
      animation: none !important;
      opacity: 0 !important;
    }
    .map-marker--surrounding .map-marker-inner {
      transition: none !important;
    }
  }

  /* --- Legend / compass overlays --- */

  .map-legend {
    position: absolute;
    top: 1rem;
    left: 1rem;
    z-index: 5;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    border-radius: 1rem;
    border: 1px solid var(--color-ink-100);
    background: rgba(255, 255, 255, 0.94);
    padding: 0.85rem 1rem;
    box-shadow: 0 10px 24px -12px rgba(10, 24, 48, 0.35);
    max-width: 210px;
  }

  .map-legend-item {
    display: flex;
    align-items: flex-start;
    gap: 0.55rem;
    font-size: 0.78rem;
    color: var(--color-ink-700);
    line-height: 1.25;
  }

  .map-legend-item strong {
    font-family: var(--font-display);
    font-weight: 700;
    color: var(--color-navy-900);
    display: block;
  }

  .map-legend-sub {
    display: block;
    font-size: 0.72rem;
    color: var(--color-ink-500);
  }

  .map-legend-dot {
    margin-top: 0.2rem;
    width: 0.85rem;
    height: 0.85rem;
    border-radius: 999px;
    flex-shrink: 0;
  }

  .map-legend-dot--primary {
    background: var(--color-orange-600);
    box-shadow: 0 0 0 3px rgba(236, 87, 19, 0.25);
  }

  .map-legend-dot--surrounding {
    background: var(--color-orange-500);
  }

  .map-legend-dot--reference {
    background: var(--color-navy-800);
  }

  .map-compass {
    position: absolute;
    /* Inset from the figure's own edge — the card clips overflow, so a
     * smaller offset crops the rose's north point. */
    top: 1.75rem;
    right: 2rem;
    z-index: 5;
    width: 2.4rem;
    height: 2.9rem;
    opacity: 0;
    animation: map-fade-in 0.6s ease-out 0.75s both;
  }

  .is-compact .map-compass {
    top: 1.25rem;
    right: 1.5rem;
    width: 1.9rem;
    height: 2.3rem;
  }

  .map-compass svg {
    width: 100%;
    height: 100%;
  }

  .map-compass-n {
    font-family: var(--font-display);
    font-size: 11px;
    font-weight: 800;
    fill: var(--color-navy-900);
  }

  /* On small screens the map renders ~316px wide, so 12px SVG text lands at
   * roughly 4 CSS px — illegible, and 15 of them overlap into noise. Drop the
   * per-marker labels (and the overlays) there and let the map be a map: the
   * "Communities We Serve" list sits directly beneath it with every name,
   * blurb and link, so nothing is lost. Colorado Springs keeps its label,
   * scaled up, since it anchors the whole picture. */
  @media (max-width: 640px) {
    .map-legend,
    .map-compass {
      display: none;
    }

    .map-marker--surrounding .map-marker-label {
      display: none;
    }

    .map-watermark {
      font-size: 30px;
    }

    .map-marker-label--primary {
      font-size: 26px;
    }

    .map-marker-sublabel {
      font-size: 16px;
    }

    .map-reference-label {
      font-size: 18px;
    }

    /* Markers themselves scale up so they stay tappable at ~316px wide. */
    .map-marker--surrounding .map-marker-inner circle {
      r: 11;
    }
  }


  .map-tooltip {
    position: absolute;
    z-index: 20;
    max-width: 240px;
    border-radius: 14px;
    border: 1px solid var(--color-ink-100);
    background: white;
    padding: 12px 14px;
    box-shadow:
      0 1px 2px rgba(10, 24, 48, 0.06),
      0 12px 28px -8px rgba(10, 24, 48, 0.22);
    /* Always interactive: both tooltip CTAs ("View Area" and "Request
     * Service") are real links a keyboard/mouse user can activate. */
    pointer-events: auto;
  }

  .map-tooltip-city {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 14px;
    color: var(--color-navy-900);
    margin: 0;
  }

  .map-tooltip-business {
    font-size: 11px;
    color: var(--color-ink-500);
    margin: 2px 0 0;
  }

  .map-tooltip-status {
    font-size: 12px;
    color: var(--color-ink-700);
    margin: 6px 0 0;
  }

  .map-tooltip-cta {
    display: none;
    align-items: center;
    gap: 5px;
    margin-top: 8px;
    font-family: var(--font-display);
    font-size: 12px;
    font-weight: 700;
    color: var(--color-orange-600);
  }

  .map-tooltip-cta--active {
    display: inline-flex;
  }

  /* ---- Compact-variant community chips (touch path below lg) ---- */
  .community-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1rem;
  }

  .community-chip {
    display: inline-flex;
    align-items: center;
    /* 44px floor - these replace marker taps on touch screens. */
    min-height: 2.75rem;
    padding: 0 0.85rem;
    border: 1px solid var(--color-ink-200);
    border-radius: 9999px;
    background: white;
    font-family: var(--font-display);
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--color-ink-700);
    text-decoration: none;
    transition:
      border-color 0.15s ease,
      color 0.15s ease;
  }

  .community-chip:hover {
    border-color: var(--color-orange-400);
    color: var(--color-orange-600);
  }

  .community-chip:focus-visible {
    outline: 2px solid var(--color-orange-500);
    outline-offset: 2px;
  }

  /* ---- Communities side panel ---- */
  .communities-panel {
    display: flex;
    flex-direction: column;
    max-height: 100%;
  }

  .communities-panel-header {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    background: var(--color-navy-900);
    color: white;
    padding: 0.9rem 1.1rem;
  }

  .communities-panel-header h3 {
    font-family: var(--font-display);
    font-size: 0.8rem;
    font-weight: 800;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .communities-panel-list {
    display: flex;
    flex-direction: column;
    max-height: 640px;
    overflow-y: auto;
  }

  .communities-panel-list li {
    border-bottom: 1px solid var(--color-ink-100);
  }

  .communities-panel-link {
    display: flex;
    gap: 0.6rem;
    align-items: flex-start;
    /* 44px floor: this list is the touch path to each community. */
    min-height: 2.75rem;
    padding: 0.7rem 1.1rem;
    text-decoration: none;
    transition: background-color 0.15s ease;
  }

  .communities-panel-link:hover {
    background: var(--color-mist-100, #f6f7f9);
  }

  .communities-panel-link:focus-visible {
    outline: 2px solid var(--color-orange-500);
    outline-offset: -2px;
  }

  .communities-panel-link:hover .communities-panel-name {
    color: var(--color-orange-600);
  }

  .communities-panel-list li:last-child {
    border-bottom: none;
  }

  .communities-panel-pin {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
    margin-top: 2px;
    color: var(--color-orange-500);
  }

  .communities-panel-name {
    display: block;
    font-family: var(--font-display);
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--color-navy-900);
  }

  .communities-panel-blurb {
    display: block;
    font-size: 0.75rem;
    line-height: 1.4;
    color: var(--color-ink-500);
    margin-top: 0.1rem;
  }

</style>

<script>
  // Vanilla JS marker interaction: hover/focus shows a tooltip with either a
  // real "View Area" link (only when a location page exists) or a
  // "Request Service" link. No runtime mapping library — this just wires
  // up the static SVG already rendered above. Runs once per map instance
  // on the page (the homepage compact map and the service-area full map
  // never render together, but this is written to be safe if they ever
  // do — each `.service-area-map` root is wired independently).
  function initServiceAreaMap(root: HTMLElement) {
    const tooltip = root.querySelector<HTMLElement>('.map-tooltip');
    if (!tooltip) return;

    const cityEl = tooltip.querySelector<HTMLElement>('.map-tooltip-city');
    const viewCta = tooltip.querySelector<HTMLAnchorElement>('.map-tooltip-cta--view');
    const requestCta = tooltip.querySelector<HTMLAnchorElement>('.map-tooltip-cta--request');
    const markers = root.querySelectorAll<SVGGElement>('[data-marker]');

    let hideTimeout: number | undefined;

    function showTooltip(marker: SVGGElement) {
      window.clearTimeout(hideTimeout);
      const name = marker.dataset.name ?? '';
      const href = marker.dataset.href ?? '';
      const hasPage = marker.dataset.hasPage === '1';

      if (cityEl) cityEl.textContent = name;

      if (hasPage && href) {
        viewCta?.setAttribute('href', href);
        viewCta?.classList.add('map-tooltip-cta--active');
        requestCta?.classList.remove('map-tooltip-cta--active');
      } else {
        viewCta?.classList.remove('map-tooltip-cta--active');
        requestCta?.classList.add('map-tooltip-cta--active');
      }

      // Measure against the map artwork's own box. NOT `root.querySelector('svg')`,
      // which would now match the first lucide icon <svg> in the card (the
      // map surface is an <img>, not an SVG) and clamp the tooltip to a
      // 14px-wide icon.
      const figure = root.querySelector<HTMLElement>('.map-figure');
      if (!figure) return;
      const svgRect = figure.getBoundingClientRect();
      const rootRect = root.getBoundingClientRect();
      const pt = marker.getBoundingClientRect();

      const left = pt.left - rootRect.left + pt.width / 2;
      const top = pt.top - rootRect.top;

      const tooltipEl = tooltip!;
      tooltipEl.hidden = false;

      // Position above the marker with enough clearance that the tooltip
      // box never overlaps the marker's own hit area (which would block
      // re-hovering it or an adjacent marker). If there isn't enough room
      // above (marker near the top of the card), place it below instead.
      const tooltipWidth = 240;
      const tooltipHeight = 132;
      const markerClearance = 22;
      let x = left - tooltipWidth / 2;
      x = Math.max(8, Math.min(x, svgRect.width - tooltipWidth - 8));

      const spaceAbove = top;
      let y: number;
      if (spaceAbove >= tooltipHeight + markerClearance) {
        y = top - tooltipHeight - markerClearance / 2;
      } else {
        y = top + markerClearance + 14;
      }

      tooltipEl.style.left = `${x}px`;
      tooltipEl.style.top = `${Math.max(0, y)}px`;
    }

    function hideTooltip(delay = 120) {
      window.clearTimeout(hideTimeout);
      hideTimeout = window.setTimeout(() => {
        tooltip!.hidden = true;
      }, delay);
    }

    // Touch has no hover, so a tap used to navigate instantly with no preview
    // of where it was going. The first tap on a marker now reveals its tooltip
    // (same content a mouse gets); a second tap on the same marker follows the
    // link. A pointer that reports hover keeps the original one-click
    // behaviour. `armedMarker` is what distinguishes the two taps.
    let armedMarker: SVGGElement | null = null;
    const hasHover = window.matchMedia('(hover: hover)').matches;

    markers.forEach((marker) => {
      marker.addEventListener('mouseenter', () => showTooltip(marker));
      marker.addEventListener('mouseleave', () => hideTooltip());
      marker.addEventListener('focus', () => showTooltip(marker));
      marker.addEventListener('blur', () => hideTooltip(0));
      marker.addEventListener('click', (e) => {
        if (!hasHover && armedMarker !== marker) {
          e.preventDefault();
          armedMarker = marker;
          showTooltip(marker);
          return;
        }
        const href = marker.dataset.href;
        if (href) window.location.href = href;
        else window.location.href = '/contact-us/';
      });
      marker.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          const href = marker.dataset.href;
          window.location.href = href || '/contact-us/';
        }
      });
    });

    tooltip.addEventListener('mouseenter', () => window.clearTimeout(hideTimeout));
    tooltip.addEventListener('mouseleave', () => hideTooltip());

    if (!hasHover) {
      document.addEventListener('click', (e) => {
        const target = e.target as Element | null;
        if (target?.closest('[data-marker]') || target?.closest('.map-tooltip')) return;
        armedMarker = null;
        hideTooltip(0);
      });
    }
  }

  function initAllServiceAreaMaps() {
    document.querySelectorAll<HTMLElement>('.service-area-map').forEach(initServiceAreaMap);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initAllServiceAreaMaps);
  } else {
    initAllServiceAreaMaps();
  }
</script>
