---
import { ArrowRight } from 'lucide-react';
import Container from '../ui/Container.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import ServiceAreaMap from './ServiceAreaMap.astro';
import TrustStrip from './TrustStrip.astro';
import { surroundingServiceAreas } from '../../data/business';
---

<section class="bg-mist-100 py-20 sm:py-28">
  <Container>
    <SectionHeading
      eyebrow="Service Area"
      title="Proudly Serving Colorado Springs & Beyond"
      description={`Fast, reliable plumbing, heating, cooling, and electrical service across Colorado Springs and ${surroundingServiceAreas.length} surrounding Colorado communities.`}
    />

    {/* Map and strip both run the full container width so their edges line
        up as one block. */}
    <div class="mt-14 w-full" data-reveal="scale">
      <ServiceAreaMap variant="compact" />
    </div>

    <TrustStrip class="mt-6" />

    <div class="mt-8 text-center">
      <a
        href="/service-area/"
        class="inline-flex min-h-11 items-center gap-1.5 text-sm font-semibold text-orange-600 hover:text-orange-700"
      >
        View full service area details <ArrowRight className="size-4" aria-hidden="true" />
      </a>
    </div>
  </Container>
</section>
