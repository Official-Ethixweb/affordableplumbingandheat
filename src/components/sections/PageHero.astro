---
import { Image } from 'astro:assets';
import Container from '../ui/Container.astro';
import Breadcrumbs from '../ui/Breadcrumbs.astro';
import IconBadge from '../ui/IconBadge.astro';
import type { ImageMetadata } from 'astro';
import type { LucideIcon } from 'lucide-react';
import type { Crumb } from '../ui/Breadcrumbs.astro';

interface Props {
  title: string;
  description?: string;
  crumbs: Crumb[];
  image?: ImageMetadata;
  imageAlt?: string;
  /** Shown in a decorative icon tile when no photo is available for this page. */
  fallbackIcon?: LucideIcon;
  /** 30% larger photo — used on About Us and Services pages. */
  large?: boolean;
}

const { title, description, crumbs, image, imageAlt = '', fallbackIcon: FallbackIcon, large = false } = Astro.props;
const imageWidth = large ? 546 : 420;
const imageHeight = large ? 416 : 320;
---

<section class="relative overflow-hidden bg-white">
  <div class="bg-orange-300/20 pointer-events-none absolute -top-24 -left-24 size-[420px] rounded-full blur-[110px]" aria-hidden="true"></div>
  <div class="bg-navy-500/15 pointer-events-none absolute -right-24 -bottom-24 size-[380px] rounded-full blur-[110px]" aria-hidden="true"></div>

  <Container class="relative grid items-center gap-10 py-16 sm:py-20 lg:grid-cols-[1.3fr_1fr] lg:py-24">
    <div>
      <Breadcrumbs crumbs={crumbs} />
      <h1 class="font-display text-ink-900 mt-4 text-4xl leading-[1.03] font-extrabold tracking-[-0.02em] text-balance sm:text-5xl">
        {title}
      </h1>
      {description && <p class="text-ink-600 mt-4 max-w-xl text-balance">{description}</p>}
    </div>

    {
      image ? (
        <div class="relative hidden lg:block" data-reveal="right">
          <div class="absolute -inset-4 -z-10 rounded-[2rem] bg-gradient-to-br from-orange-500/15 to-navy-500/10 blur-2xl" aria-hidden="true" />
          <Image
            src={image}
            alt={imageAlt}
            width={imageWidth}
            height={imageHeight}
            densities={[1, 2]}
            quality="high"
            class:list={['shadow-card-hover ml-auto aspect-[4/3] w-full rounded-[2rem] object-cover', large ? 'max-w-[546px]' : 'max-w-[420px]']}
            loading="eager"
          />
        </div>
      ) : (
        FallbackIcon && (
          <div class="relative hidden lg:flex lg:justify-end" data-reveal="right">
            <div class="absolute -inset-4 -z-10 rounded-[2rem] bg-gradient-to-br from-orange-500/15 to-navy-500/10 blur-2xl" aria-hidden="true" />
            {/* 24 of the 42 services have no photograph, so this tile is what
                a visitor sees on more than half of them. A flat navy box with
                one small glyph read as a missing image; the gradient, the
                oversized watermark and the ring make it read as a deliberate
                treatment instead. Matches the photo branch's aspect and width
                so the two never change the page's rhythm. */}
            <div
              class:list={[
                'shadow-card-hover from-navy-800 to-navy-950 relative flex aspect-[4/3] w-full items-center justify-center overflow-hidden rounded-[2rem] bg-gradient-to-br ring-1 ring-white/10 ring-inset',
                large ? 'max-w-[546px]' : 'max-w-[420px]'
              ]}
            >
              <div
                class="pointer-events-none absolute -top-10 -left-10 size-64 rounded-full bg-orange-500/20 blur-3xl"
                aria-hidden="true"
              >
              </div>
              <FallbackIcon
                className="pointer-events-none absolute -right-8 -bottom-10 size-64 text-white/[0.06]"
                aria-hidden="true"
                strokeWidth={1}
              />
              <IconBadge icon={FallbackIcon} tone="white" size="lg" class="relative !size-24 [&>svg]:!size-12" />
            </div>
          </div>
        )
      )
    }
  </Container>
</section>
