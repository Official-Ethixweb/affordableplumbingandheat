# Copy this file to .env and fill in real values for local development.
# Never commit .env with real secrets.

# Resend (https://resend.com) — used to email leads from the contact form
# and chatbot. Leave unset and the /api/lead endpoint will log leads to the
# server console instead of emailing them (safe no-op, no build/runtime error).
RESEND_API_KEY=
# Destination inbox for lead notifications. Defaults to the business email
# in src/data/business.ts if unset.
LEAD_TO_EMAIL=
# Verified "from" address in your Resend account/domain.
LEAD_FROM_EMAIL=

# Cloudflare Turnstile (bot/spam protection) for the contact form and quick
# lead form. Get both keys from dash.cloudflare.com -> Turnstile -> Add
# widget manually.
# - PUBLIC_TURNSTILE_SITE_KEY is public/client-exposed (rendered into the
#   page to load the widget) — safe to ship in client JS.
# - TURNSTILE_SECRET_KEY must stay server-only. Never expose it to the
#   client or commit a real value.
# In production, POST /api/lead FAILS CLOSED: if TURNSTILE_SECRET_KEY is
# missing, or a submission arrives with a missing/invalid token, the request
# is rejected. The only bypass is local dev / preview deploys with no
# TURNSTILE_SECRET_KEY configured, so contributors aren't forced to
# provision a Turnstile widget just to run the app locally.
TURNSTILE_SECRET_KEY=
PUBLIC_TURNSTILE_SITE_KEY=

# Optional: analytics/tracking. Leave unset to skip.
PUBLIC_GA4_ID=
PUBLIC_GTM_ID=
PUBLIC_CALLRAIL_COMPANY_ID=
PUBLIC_CALLRAIL_SCRIPT_ID=
